MONIT_API_URL=http://develop:8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@tu_dominio
SMTP_APP_PASSWORD=

REPORTE_ASUNTO=Informe de plantas [Cliente]
REPORTE_CUERPO="Hola a todos:
Anexo a la presente el informe de cámaras y servidores de [cliente].
Quedo atento a sus comentarios
Saludos"

REPORTE_DESTINATARIOS_DEFAULT=correo1@dominio.com,correo2@dominio.com
# Por cliente (nombre normalizado a mayúsculas, ej. REPORTE_DESTINATARIOS_API_MANZANILLO): si no
# se pone, ese cliente usa el default de arriba. Dejarla vacía (REPORTE_DESTINATARIOS_X=) NO evita
# el envío -- un valor vacío también cae al default, igual que si la variable no existiera. Para
# que a un cliente específico de verdad no se le mande nada, usa el valor especial NINGUNO:
# REPORTE_DESTINATARIOS_C5I_COLIMA=NINGUNO
